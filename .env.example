# Spotify Integration (optional — only needed for playback sync)
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional lyric translation (any OpenAI- or Anthropic-compatible LLM API).
# Provider defaults to OpenAI-compatible; set TRANSLATION_PROVIDER=anthropic for Anthropic Messages API.
# If TRANSLATION_API_KEY is unset, DEEPSEEK_API_KEY is used as a fallback.
TRANSLATION_PROVIDER=openai
TRANSLATION_BASE_URL=https://api.deepseek.com/v1
TRANSLATION_API_KEY=
TRANSLATION_MODEL=deepseek-v4-flash
TRANSLATION_TARGET_LANG=zh-CN
# Set redirect URI to http://localhost:3000/api/auth/callback in Spotify Dashboard

# Optional: override the redirect URI (defaults to request origin + /api/auth/callback)
# SPOTIFY_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Optional: require a passphrase before starting Spotify OAuth.
# The passphrase is validated server-side and never exposed to the browser bundle.
JPLRC_LOGIN_PASSPHRASE_REQUIRED=false
JPLRC_LOGIN_PASSPHRASE=NEVERGONNAGIVEYOUUP

# Recommended in production: signs login/session cookies independently of Spotify credentials.
SESSION_SECRET=

# HTTP lyrics providers (ISSUE #148) — deployment-level network policy + budgets.
# These are env-only; admins/users cannot override them from the UI or database.
# Boolean values accept only an explicit `true` (any other value = false / fail-closed).
LYRICS_PROVIDER_ALLOW_HTTP=false
LYRICS_PROVIDER_ALLOW_PRIVATE_NETWORK=false
# Required to store Bearer-token providers (AES-GCM encryption at rest).
LYRICS_PROVIDER_SECRET_KEY=
# Optional per-provider / chain budgets (ms). Missing/invalid values fall back to safe defaults.
LYRICS_PROVIDER_DEFAULT_TIMEOUT_MS=20000
LYRICS_PROVIDER_MAX_TIMEOUT_MS=60000
LYRICS_PROVIDER_MANIFEST_TIMEOUT_MS=15000
LYRICS_PROVIDER_CHAIN_TIMEOUT_MS=180000

# Docker Compose / Traefik deployment (values live in .env, never committed).
# docker-compose.yml references these via ${VAR}; copy them into your local .env.
JPLRC_DOMAIN=jplrc.example.com
JPLRC_PORT=3000
TRAEFIK_NETWORK=traefik_traefik-net
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
TRAEFIK_AUTH_MIDDLEWARE=kazusa-auth@docker
