{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "jp-lyrics-app",
	"compatibility_date": "2026-06-10",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "jp-lyrics-app"
		}
	],
	"r2_buckets": [
		// Use R2 incremental cache
		// See https://opennext.js.org/cloudflare/caching
		{
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			// Create the bucket before deploying
			// You can change the bucket name if you want
			// See https://developers.cloudflare.com/workers/wrangler/commands/#r2-bucket-create
			"bucket_name": "jp-lyrics-app-opennext-cache"
		},
		// Custom album covers (uploaded artwork, not Spotify CDN URLs).
		// Create the bucket before deploying: wrangler r2 bucket create jp-lyrics-app-covers
		{
			"binding": "COVER_R2_BUCKET",
			"bucket_name": "jp-lyrics-app-covers"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"d1_databases": [
	  {
	    "binding": "DB",
	    "database_name": "jp-lyrics-app",
	    "database_id": "a9b7c22d-16d1-4ae1-b84c-1138d238f293"
	  }
	],
	"ai": {
	  // Workers AI binding — translation uses it when TRANSLATION_PROVIDER=workers-ai
	  "binding": "AI"
	},
	"vars": {
	  // Cloudflare deploys translate with Workers AI by default (Gemini 3.6 Flash)
	  "TRANSLATION_PROVIDER": "workers-ai"
	},
	"observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {}
  }
}